<div id="fruitMergeCard" style="
  max-width:480px;
  margin:20px auto;
  overflow:hidden;
  border-radius:20px;
  background:#fff8df;
  box-shadow:0 5px 16px #0002;
  font-family:Arial,sans-serif;
">

  <!-- GAME LIST CARD / LOGO -->
  <div id="fruitMergeCover" style="
    padding:24px 16px;
    text-align:center;
    background:linear-gradient(145deg,#96a9cf,#c49a6b);
  ">

    <div style="
      width:90px;
      height:90px;
      margin:0 auto 14px;
      border-radius:24px;
      background:#fff8df;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:58px;
    ">🍉</div>

    <h2 style="
      margin:0;
      color:#fff8df;
      font-size:28px;
      font-weight:900;
    ">FRUIT MERGE</h2>

    <p style="
      margin:10px 0 18px;
      color:#603719;
      font-weight:bold;
    ">Drop • Merge • Grow</p>

    <button id="fruitMergePlay" type="button" style="
      width:100%;
      max-width:270px;
      padding:15px;
      border:3px solid white;
      border-radius:16px;
      background:#68db28;
      color:white;
      font-size:18px;
      font-weight:900;
      cursor:pointer;
    ">▶ PLAY NOW</button>

  </div>

  <!-- GAME FRAME: HIDDEN UNTIL PLAY NOW -->
  <div id="fruitMergeGameArea" style="display:none;">

    <iframe
      id="fruitMergeFrame"
      title="Fruit Merge Game"
      src="about:blank"
      data-src="https://YOUR-USERNAME.github.io/fruit-merge-game/"
      allow="fullscreen; gamepad"
      allowfullscreen
      style="
        display:block;
        width:100%;
        height:760px;
        border:0;
        background:#96a9cf;
      ">
    </iframe>

  </div>

</div>

<script>
(function(){

  var playButton = document.getElementById("fruitMergePlay");
  var cover = document.getElementById("fruitMergeCover");
  var gameArea = document.getElementById("fruitMergeGameArea");
  var frame = document.getElementById("fruitMergeFrame");

  playButton.addEventListener("click", function(){

    var gameURL = frame.getAttribute("data-src");

    if (!gameURL ||
        gameURL.indexOf("YOUR-USERNAME") !== -1) {
      alert("Please add your GitHub Pages URL first.");
      return;
    }

    cover.style.display = "none";
    gameArea.style.display = "block";

    if (frame.getAttribute("src") === "about:blank") {
      frame.setAttribute("src", gameURL);
    }

    // Request fullscreen following the user's click.
    if (frame.requestFullscreen) {
      frame.requestFullscreen().catch(function(){});
    }

  });

})();
</script>
